doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Application Page
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css' rel='stylesheet')
  style.
    body {
    background:
    linear-gradient(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.35)),
    url("/Assets/resortlooks/pool\ side.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    min-height: 100vh;
    }
    /* Glass Navbar */
    .navbar {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
    }
    .navbar-brand {
    font-weight: 700;
    color: black !important;
    }
    .nav-link {
    font-weight: 500;
    color: black !important;
    }
    .nav-link:hover {
    color: #fd5f97 !important;
    }
    /* Form Card */
    .form-card {
    max-width: 700px;
    margin: auto;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 15px;
    }
    /* Custom Button */
    .btn-outline-secondary {
    background-color: #fd5f97 !important;
    border-color: #fd5f97 !important;
    color: white !important;
    }
    .btn-outline-secondary:hover {
    background-color: #e94c86 !important;
    border-color: #e94c86 !important;
    }
    /* Input Styling */
    .form-control {
    border-radius: 10px;
    }
    .form-control:focus {
    border-color: #fd5f97;
    box-shadow: 0 0 0 0.25rem rgba(253, 95, 151, 0.25);
    }
    /* Heading */
    .page-title {
    color: white;
    text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.5);
    }
    /* Glass Footer */
    footer {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: black;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    }
    footer p {
    margin: 0;
    font-weight: 500;
    }
// Navbar
nav.navbar.navbar-expand-lg
  .container
    a.navbar-brand(href='index.html') Home
    button.navbar-toggler.bg-light(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNav')
      span.navbar-toggler-icon
    #navbarNav.collapse.navbar-collapse
      ul.navbar-nav.ms-auto
        li.nav-item
          a.nav-link.active(href='#') Sign-In
        li.nav-item
          a.nav-link(href='aboutus.html') About Us
        li.nav-item
          a.nav-link(href='ourbookings.html') Bookings
        li.nav-item
          a.nav-link(href='/pageLayouts/Menu/mainMenu.html') Menu
        li.nav-item
          a.nav-link(href='signout.html') Logout
        li.nav-item
          a.nav-link(href='/pageLayouts/Forms/applications.html')
            | Forms
// Page Heading
.container.py-5
  .text-center.mb-5
    h1.display-5.fw-bold.page-title
      | This is the Application Page
  // Form
  .card.shadow.border-0.form-card
    .card-body.p-4.p-md-5
      h3.mb-3 Application Forms
      p.text-muted.mb-4
        | We are hiring two waiters and two waitresses to join our workforce.
        | Feel free to apply now.
      form
        .mb-3
          label.form-label(for='firstName') First Name
          input#firstName.form-control(type='text' name='firstName')
        .mb-3
          label.form-label(for='lastName') Last Name
          input#lastName.form-control(type='text' name='lastName')
        .mb-3
          label.form-label(for='age') Age
          input#age.form-control(type='number' name='age')
        .mb-3
          label.form-label(for='phoneNumber') Phone Number
          input#phoneNumber.form-control(type='tel' name='phoneNumber')
        .mb-4
          label.form-label(for='email') Email
          input#email.form-control(type='email' name='email')
        button.btn.btn-outline-secondary.px-4(type='submit')
          | Submit
      .mt-4
        button.btn.btn-outline-secondary.px-4
          | Next
// Footer
footer.text-center.py-4.mt-5
  p.mb-0
    | &copy; 2026 Parvin Savor Resort. All rights reserved.
script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js')
