doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Resort Guest Registration
  // Bootstrap CSS
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css' rel='stylesheet')
  // Bootstrap Icons
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css')
  style.
    body {
    background:
    linear-gradient(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.35)),
    url("/Assets/resortlooks/sea\ view.jpg");
    background-size: cover;
    background-position: center;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    }
    .signup-card {
    background: rgba(255, 255, 255, 0.96);
    border-radius: 25px;
    backdrop-filter: blur(10px);
    }
    .resort-icon {
    font-size: 4rem;
    color: #ff4d94;
    }
    .btn-pink {
    background-color: #ff4d94;
    border: none;
    color: white;
    font-weight: 600;
    }
    .btn-pink:hover {
    background-color: #e63c81;
    color: white;
    }
    .form-control:focus,
    .form-select:focus {
    border-color: #ff4d94;
    box-shadow: 0 0 0 0.2rem rgba(255, 77, 148, 0.25);
    }
    footer {
    background: rgba(0, 0, 0, 0.85);
    color: white;
    margin-top: auto;
    }
    .footer-link {
    color: #ffb6d5;
    text-decoration: none;
    }
    .footer-link:hover {
    color: white;
    }
// Signup Section
.container.py-5.flex-grow-1.d-flex.align-items-center.justify-content-center
  .card.signup-card.shadow-lg.border-0.w-100(style='max-width: 850px')
    .card-body.p-4.p-md-5
      .text-center.mb-4
        i.bi.bi-house-heart-fill.resort-icon
        h1.fw-bold.mt-3 Welcome to Parvin Savor Resort
        p.text-muted
          | Create your guest account and begin your luxurious getaway.
      form
        .row.g-3
          .col-md-6
            label.form-label.fw-semibold First Name
            input.form-control(type='text' placeholder='Enter first name')
          .col-md-6
            label.form-label.fw-semibold Last Name
            input.form-control(type='text' placeholder='Enter last name')
          .col-md-6
            label.form-label.fw-semibold Email Address
            input.form-control(type='email' placeholder='Enter email')
          .col-md-6
            label.form-label.fw-semibold Phone Number
            input.form-control(type='tel' placeholder='Enter phone number')
          .col-md-6
            label.form-label.fw-semibold Room Preference
            select.form-select
              option(selected='') Select Room Type
              option Standard Room
              option Deluxe Room
              option Executive Suite
              option Private Villa
          .col-md-6
            label.form-label.fw-semibold Number of Guests
            input.form-control(type='number' placeholder='Guests')
          .col-md-6
            label.form-label.fw-semibold Password
            input.form-control(type='password' placeholder='Create password')
          .col-md-6
            label.form-label.fw-semibold Confirm Password
            input.form-control(type='password' placeholder='Confirm password')
          .col-12
            .form-check.mt-2
              input#terms.form-check-input(type='checkbox')
              label.form-check-label(for='terms')
                | I agree to the Terms &amp; Conditions and Privacy Policy.
          .col-12.mt-3
            .d-grid
              button.btn.btn-pink.btn-lg(type='submit')
                i.bi.bi-person-plus-fill.me-2
                |                     Create Account
      .text-center.mt-4
        p.mb-0
          | Already have an account?
          a.text-decoration-none.fw-semibold.text-danger(href='#')
            | Sign In
// Footer
//
  <footer class="py-4">
  <div class="container">
  <div class="row text-center text-md-start">
  <div class="col-md-4 mb-3 mb-md-0">
  <h5 class="fw-bold">Parvin Savor Resort</h5>
  <p class="small mb-0">
  Experience luxury, comfort, and unforgettable memories in a tropical paradise.
  </p>
  </div>
  <div class="col-md-4 mb-3 mb-md-0">
  <h5 class="fw-bold">Quick Links</h5>
  <ul class="list-unstyled">
  <li><a href="#" class="footer-link">Home</a></li>
  <li><a href="#" class="footer-link">Rooms</a></li>
  <li><a href="#" class="footer-link">Services</a></li>
  <li><a href="#" class="footer-link">Contact</a></li>
  </ul>
  </div>
  <div class="col-md-4">
  <h5 class="fw-bold">Contact Us</h5>
  <p class="small mb-1">
  <i class="bi bi-geo-alt-fill me-2"></i>Villa Avenue
  </p>
  <p class="small mb-1">
  <i class="bi bi-telephone-fill me-2"></i>+256 700 123 456
  </p>
  <p class="small mb-0">
  <i class="bi bi-envelope-fill me-2"></i>infoparvin.s.resort@gmail.com
  </p>
  </div>
  </div>
  <hr class="border-secondary my-3">
.text-center
