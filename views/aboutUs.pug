doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Parvin Resort About Us Page
  // Bootstrap CSS
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css' rel='stylesheet')
  style.
    /* Page Layout */
    body {
    background:
    linear-gradient(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.35)),
    url("/Assets/resortlooks/sea view.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    }
    main {
    flex: 1;
    }
    /* Navbar */
    .navbar {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.15);
    }
    .navbar-brand,
    .nav-link {
    color: black !important;
    font-weight: 500;
    }
    .nav-link:hover {
    color: #fd5f97 !important;
    }
    /* Main Content Card */
    .content-card {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 40px;
    color: black;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    }
    /* Headings */
    .section-title {
    font-weight: 700;
    margin-bottom: 20px;
    }
    .lead {
    line-height: 1.8;
    }
    /* Table */
    .table-container {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 15px;
    overflow: hidden;
    }
    .table {
    margin-bottom: 0;
    }
    /* Workforce Image */
    .workforce-image {
    width: 100%;
    max-height: 450px;
    object-fit: cover;
    border-radius: 15px;
    margin-top: 20px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    }
    /* Buttons */
    .btn-resort {
    background-color: #fd5f97;
    border-color: #fd5f97;
    color: white;
    padding: 12px 30px;
    font-weight: 600;
    }
    .btn-resort:hover {
    background-color: #eb4d86;
    border-color: #eb4d86;
    color: white;
    }
    /* Footer */
    footer {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    color: black;
    }
    /* Mobile */
    @media (max-width: 768px) {
    .content-card {
    padding: 25px;
    }
    .section-title {
    font-size: 1.8rem;
    }
    .lead {
    font-size: 1rem;
    }
    }
// Navbar
nav.navbar.navbar-expand-lg
  .container
    a.navbar-brand.fw-bold(href='index.html')
      | Parvin Resort
    button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNav')
      span.navbar-toggler-icon
    #navbarNav.collapse.navbar-collapse
      ul.navbar-nav.ms-auto
        li.nav-item
          a.nav-link(href='index.html')
            | Home
        li.nav-item
          a.nav-link.active(href='aboutus.html')
            | About Us
        li.nav-item
          a.nav-link(href='ourbookings.html')
            | Bookings
        li.nav-item
          a.nav-link(href='/pageLayouts/Menu/mainMenu.html')
            | Main Menu
        li.nav-item
          a.nav-link(href='#')
            | Forms
        li.nav-item
          a.nav-link(href='#')
            | Logout
main
  // About Section
  section.container.py-5
    .content-card
      .text-center.mb-5
        h1.display-5.fw-bold
          | About Parvin Savor Resort
        p.lead
          | Welcome to Parvin Savor, a place to relax, chill and work.
          | We cover all things from meals that are both local and
          | intercontinental down to our luxurious suites.
        p.lead
          | Parvin Savor Resort is located in Kampala, Uganda,
          | with branches in London (Parvin Kitchen Delight).
      // Workforce Section
      .mt-5
        h2.section-title.text-center
          | Our Different Workforce
        p.lead.text-center.mb-4
          | Parvin Savor works with a team of beautiful minds dedicated
          | to providing exceptional hospitality and customer service.
        // Bootstrap Table
        .table-container.shadow
          .table-responsive
            table.table.table-striped.table-hover.align-middle
              thead.table-dark
                tr
                  th Name
                  th Position
                  th Contact
              tbody
                tr
                  td Tusiime Ruth Parvin
                  td
                    span.badge.bg-primary
                      | Founder &amp; Owner
                  td 07709500503
                tr
                  td Conrad J. Mordecai
                  td
                    span.badge.bg-success
                      | Manager
                  td 07597232183
                tr
                  td Nimungu Mildred
                  td
                    span.badge.bg-warning.text-dark
                      | Admin
                  td 07868753423
                tr
                  td Queen Beth
                  td
                    span.badge.bg-info.text-dark
                      | Supervisor
                  td 07413622823
        // Workforce Image
        .text-center.mt-5
          img.workforce-image(src='workforce.jpg' alt='Image showing the workforce')
      // Call to Action
      .text-center.mt-5
        a.btn.btn-resort.btn-lg(href='ourbookings.html')
          | Make a Booking
// Footer
footer.text-center.py-4
  .container
    p.mb-0
      | &copy; 2026 Parvin Savor Resort. All rights reserved.
// Bootstrap JS
script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js')
