doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Resort Sign Out
  // Bootstrap CSS
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css' rel='stylesheet')
  // Bootstrap Icons
  link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css')
  style.
    body {
    background:
    linear-gradient(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.35)),
    url("/Assets/resortlooks/sea\ view.jpg");
    background-size: cover;
    background-position: center;
    min-height: 100vh;
    }
    .signout-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-radius: 20px;
    }
    .pink-btn {
    background-color: #ff4f9a;
    border: none;
    color: white;
    transition: 0.3s;
    }
    .pink-btn:hover {
    background-color: #e83e8c;
    color: white;
    transform: translateY(-2px);
    }
    .resort-icon {
    font-size: 4rem;
    color: #ff4f9a;
    }
    .info-box {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 12px;
    }
.container.min-vh-100.d-flex.justify-content-center.align-items-center.py-5
  .card.signout-card.shadow-lg.border-0(style='max-width: 650px; width: 100%')
    .card-body.p-5
      .text-center.mb-4
        i.bi.bi-house-heart-fill.resort-icon
        h1.fw-bold.mt-3 Parvin Savor Resort Sign Out
        p.text-muted
          | Thank you for staying with us. Please review your visit details
          | before signing out.
      .row.g-3.mb-4
        .col-md-6
          .info-box
            small.text-muted Guest Name
            h6.mb-0.fw-bold Parvin Rulz
        .col-md-6
          .info-box
            small.text-muted Room Number
            h6.mb-0.fw-bold Villa 12
        .col-md-6
          .info-box
            small.text-muted Check-In
            h6.mb-0.fw-bold 02 June 2026
        .col-md-6
          .info-box
            small.text-muted Check-Out
            h6.mb-0.fw-bold 05 June 2026
      .alert.alert-light.border.text-center
        h5.fw-bold.mb-1 Total Bill
        h2.text-success.fw-bold $450.00
      .mb-4
        label.form-label.fw-semibold Feedback
        textarea.form-control(rows='4' placeholder='Tell us about your experience...')
      .d-grid.gap-3
        button.btn.pink-btn.btn-lg
          i.bi.bi-box-arrow-right.me-2
          |               Confirm Sign Out
        button.btn.btn-outline-secondary
          i.bi.bi-arrow-left.me-2
          |               Return to Dashboard
      hr.my-4
      p.text-center.text-muted.mb-0
        | We hope to welcome you again soon. &#x1F334;
// Footer
//
  <footer class="py-4">
  <div class="container">
  <div class="row text-center text-md-start">
  <div class="col-md-4 mb-3 mb-md-0">
  <h5 class="fw-bold">Parvin Savor Resort</h5>
  <p class="small mb-0">
  Experience luxury, comfort, and unforgettable memories in a
  tropical paradise.
  </p>
  </div>
  <div class="col-md-4 mb-3 mb-md-0">
  <h5 class="fw-bold">Quick Links</h5>
  <ul class="list-unstyled">
  <li><a href="#" class="footer-link">Home</a></li>
  <li><a href="#" class="footer-link">Rooms</a></li>
  <li><a href="#" class="footer-link">Services</a></li>
  <li><a href="#" class="footer-link">Contact</a></li>
  </ul>
  </div>
  <div class="col-md-4">
  <h5 class="fw-bold">Contact Us</h5>
  <p class="small mb-1">
  <i class="bi bi-geo-alt-fill me-2"></i>Villa Avenue
  </p>
  <p class="small mb-1">
  <i class="bi bi-telephone-fill me-2"></i>+256 700 123 456
  </p>
  <p class="small mb-0">
  <i class="bi bi-envelope-fill me-2"></i
  >infoparvin.s.resort@gmail.com
  </p>
  </div>
  </div>
  <hr class="border-secondary my-3" />
.text-center
